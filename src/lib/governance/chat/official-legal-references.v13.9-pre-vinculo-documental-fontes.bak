import type { GovernanceChatReference } from "@/lib/governance/chat/references";

function normalizeOfficialLegalResolverText(value: string) {
  return String(value ?? "")
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase();
}

type OfficialLegalResolverEntry = {
  title: string;
  url: string;
  triggers: string[];
};

