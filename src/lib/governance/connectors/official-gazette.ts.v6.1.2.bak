export type DiscoveredOfficialEdition = {
  title: string;
  pdfUrl: string;
  editionNumber: string | null;
  publicationDate: string | null;
};

export interface OfficialSourceConnector {
  discover(sourceUrl: string): Promise<DiscoveredOfficialEdition[]>;
}

const HTML_ENTITIES: Record<string, string> = {
  amp: "&",
  quot: '"',
  apos: "'",
  "#39": "'",
  nbsp: " ",
  ordm: "º",
  deg: "°",
  ccedil: "ç",
  Ccedil: "Ç",
  atilde: "ã",
  Atilde: "Ã",
  aacute: "á",
  Aacute: "Á",
  eacute: "é",
  Eacute: "É",
  iacute: "í",
  Iacute: "Í",
  oacute: "ó",
  Oacute: "Ó",
  uacute: "ú",
  Uacute: "Ú",
};

function decodeHtmlEntities(value: string) {
  return value.replace(/&(#x?[0-9a-f]+|[a-z]+);/gi, (entity, code: string) => {
    if (code.startsWith("#x") || code.startsWith("#X")) {
      const parsed = Number.parseInt(code.slice(2), 16);
      return Number.isFinite(parsed) ? String.fromCodePoint(parsed) : entity;
    }

    if (code.startsWith("#")) {
      const parsed = Number.parseInt(code.slice(1), 10);
      return Number.isFinite(parsed) ? String.fromCodePoint(parsed) : entity;
    }

    return HTML_ENTITIES[code] ?? HTML_ENTITIES[code.toLowerCase()] ?? entity;
  });
}

function decodeHtml(value: string) {
  return decodeHtmlEntities(value)
    .replace(/<script\b[\s\S]*?<\/script>/gi, " ")
    .replace(/<style\b[\s\S]*?<\/style>/gi, " ")
    .replace(/<[^>]+>/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function normalizeForSearch(value: string) {
  return decodeHtml(value)
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[º°]/g, "o");
}

function normalizeDate(value: string | null) {
  if (!value) return null;

  const isoMatch = value.match(/\b(20\d{2})[-/](\d{2})[-/](\d{2})\b/);
  if (isoMatch) return `${isoMatch[1]}-${isoMatch[2]}-${isoMatch[3]}`;

  const brMatch = value.match(/\b(\d{1,2})[/.](\d{1,2})[/.](20\d{2})\b/);
  if (!brMatch) return null;

  return `${brMatch[3]}-${brMatch[2].padStart(2, "0")}-${brMatch[1].padStart(2, "0")}`;
}

function extractEditionNumber(value: string) {
  const normalized = normalizeForSearch(value);
  const patterns = [
    /\bedicao\s*(?:n(?:o)?[.\s]*)?([0-9][0-9./-]*)/i,
    /\bn(?:o)?[.\s]+([0-9][0-9./-]*)/i,
  ];

  for (const pattern of patterns) {
    const match = normalized.match(pattern);
    if (match?.[1]) return match[1].trim();
  }

  return null;
}

function extractClosestMetadata(html: string, anchorIndex: number) {
  const contextStart = Math.max(0, anchorIndex - 1800);
  const precedingText = decodeHtml(html.slice(contextStart, anchorIndex));
  const normalized = normalizeForSearch(precedingText);

  const editionPattern = /\bedicao\s*(?:n(?:o)?[.\s]*)?([0-9][0-9./-]*)/gi;
  const matches = [...normalized.matchAll(editionPattern)];
  const closestEdition = matches.at(-1);

  if (!closestEdition?.[1]) {
    return {
      editionNumber: null,
      publicationDate: normalizeDate(precedingText),
    };
  }

  const editionNumber = closestEdition[1].trim();
  const metadataTail = normalized.slice(closestEdition.index ?? 0);
  const publicationDate = normalizeDate(metadataTail);

  return {
    editionNumber,
    publicationDate,
  };
}

function buildTitle(label: string, editionNumber: string | null) {
  if (editionNumber) return `Diário Oficial nº ${editionNumber}`;
  return label || "Diário Oficial";
}

export class HtmlOfficialGazetteConnector implements OfficialSourceConnector {
  async discover(sourceUrl: string): Promise<DiscoveredOfficialEdition[]> {
    const normalizedSourceUrl = new URL(sourceUrl).toString();

    if (/\.pdf(?:$|[?#])/i.test(normalizedSourceUrl)) {
      return [{
        title: "Diário Oficial",
        pdfUrl: normalizedSourceUrl,
        editionNumber: extractEditionNumber(normalizedSourceUrl),
        publicationDate: normalizeDate(normalizedSourceUrl),
      }];
    }

    const response = await fetch(normalizedSourceUrl, {
      cache: "no-store",
      headers: {
        "User-Agent": "Publ.IA/6.1 (+sincronizacao-diario-oficial)",
        Accept: "text/html,application/xhtml+xml",
      },
    });

    if (!response.ok) {
      throw new Error(`Portal oficial respondeu com status ${response.status}.`);
    }

    const html = await response.text();
    const editions = new Map<string, DiscoveredOfficialEdition>();
    const anchorPattern = /<a\b[^>]*href\s*=\s*(["'])(.*?)\1[^>]*>([\s\S]*?)<\/a>/gi;

    for (const match of html.matchAll(anchorPattern)) {
      const href = decodeHtml(match[2] ?? "");
      if (!href || !/\.pdf(?:$|[?#])/i.test(href)) continue;

      const pdfUrl = new URL(href, normalizedSourceUrl).toString();
      const label = decodeHtml(match[3] ?? "");
      const anchorIndex = match.index ?? 0;
      const closestMetadata = extractClosestMetadata(html, anchorIndex);

      const fallbackContextStart = Math.max(0, anchorIndex - 300);
      const fallbackContextEnd = Math.min(
        html.length,
        anchorIndex + match[0].length + 100,
      );
      const fallbackMetadata = decodeHtml(
        html.slice(fallbackContextStart, fallbackContextEnd),
      );

      const editionNumber =
        closestMetadata.editionNumber ??
        extractEditionNumber(`${label} ${fallbackMetadata} ${pdfUrl}`);

      const publicationDate =
        closestMetadata.publicationDate ??
        normalizeDate(`${label} ${fallbackMetadata} ${pdfUrl}`);

      editions.set(pdfUrl, {
        title: buildTitle(label, editionNumber),
        pdfUrl,
        editionNumber,
        publicationDate,
      });
    }

    return [...editions.values()];
  }
}
